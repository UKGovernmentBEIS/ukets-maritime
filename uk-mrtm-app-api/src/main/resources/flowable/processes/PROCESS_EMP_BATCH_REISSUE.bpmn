<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://flowable.org/emp" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <message id="message_empReissueCompleted" name="empReissueCompleted" />
  <process id="PROCESS_EMP_BATCH_REISSUE" name="EMP Batch Reissue Process" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_1opujsq</outgoing>
    </startEvent>
    <sequenceFlow id="Flow_1opujsq" sourceRef="StartEvent_1" targetRef="Activity_131ih32" />
    <serviceTask id="Activity_131ih32" name="EMP batch reissue submitted" flowable:delegateExpression="#{empBatchReissueSubmittedHandlerFlowable}" flowable:async="true">
      <incoming>Flow_1opujsq</incoming>
      <outgoing>Flow_06vywy1</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_06vywy1" sourceRef="Activity_131ih32" targetRef="Gateway_1wifmxg" />
    <exclusiveGateway id="Gateway_1wifmxg" name="check accounts size" default="Flow_18vyfjp">
      <incoming>Flow_06vywy1</incoming>
      <outgoing>Flow_1v0rz0n</outgoing>
      <outgoing>Flow_18vyfjp</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_1v0rz0n" sourceRef="Gateway_1wifmxg" targetRef="SubProcess_waitAccountCompleted">
      <conditionExpression xsi:type="tFormalExpression">${accountIds.size() &gt; 0}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_18vyfjp" sourceRef="Gateway_1wifmxg" targetRef="Activity_1v1o7ti" />
    <subProcess id="SubProcess_waitAccountCompleted" name="Wait for account reissue completed">
      <incoming>Flow_1v0rz0n</incoming>
      <outgoing>Flow_reissue_to_report</outgoing>
      <multiInstanceLoopCharacteristics flowable:collection="accountIds" flowable:elementVariable="accountId">
        <completionCondition>${nrOfCompletedInstances == nrOfInstances}</completionCondition>
      </multiInstanceLoopCharacteristics>
      <startEvent id="SubProcess_wait_start">
        <outgoing>Flow_subwait_start_to_catch</outgoing>
      </startEvent>
      <sequenceFlow id="Flow_subwait_start_to_catch" sourceRef="SubProcess_wait_start" targetRef="Activity_0lpi6k4" />
      <intermediateCatchEvent id="Event_waitAccountCompleted" name="Wait for account reissue completed">
        <incoming>Flow_01ommkk</incoming>
        <outgoing>Flow_subwait_catch_to_end</outgoing>
        <messageEventDefinition messageRef="message_empReissueCompleted" />
      </intermediateCatchEvent>
      <sequenceFlow id="Flow_subwait_catch_to_end" sourceRef="Event_waitAccountCompleted" targetRef="SubProcess_wait_end" />
      <endEvent id="SubProcess_wait_end">
        <incoming>Flow_subwait_catch_to_end</incoming>
      </endEvent>
      <serviceTask id="Activity_0lpi6k4" name="trigger EMP reissue" flowable:delegateExpression="#{empBatchTriggerEmpReissueHandlerFlowable}">
        <incoming>Flow_subwait_start_to_catch</incoming>
        <outgoing>Flow_01ommkk</outgoing>
      </serviceTask>
      <sequenceFlow id="Flow_01ommkk" sourceRef="Activity_0lpi6k4" targetRef="Event_waitAccountCompleted" />
    </subProcess>
    <sequenceFlow id="Flow_reissue_to_report" sourceRef="SubProcess_waitAccountCompleted" targetRef="Activity_1v1o7ti" />
    <serviceTask id="Activity_1v1o7ti" name="generate report" flowable:async="true" flowable:delegateExpression="#{empBatchReissueGenerateReportHandlerFlowable}">
      <incoming>Flow_18vyfjp</incoming>
      <incoming>Flow_reissue_to_report</incoming>
      <outgoing>Flow_1v51yh4</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_1v51yh4" sourceRef="Activity_1v1o7ti" targetRef="Activity_0xd0pff" />
    <serviceTask id="Activity_0xd0pff" name="EMP batch reissue completed" flowable:delegateExpression="#{empBatchReissueCompletedHandlerFlowable}">
      <incoming>Flow_1v51yh4</incoming>
      <outgoing>Flow_1tc33w4</outgoing>
    </serviceTask>
    <sequenceFlow id="Flow_1tc33w4" sourceRef="Activity_0xd0pff" targetRef="Event_05qh1be" />
    <endEvent id="Event_05qh1be">
      <incoming>Flow_1tc33w4</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PROCESS_EMP_BATCH_REISSUE">
    <bpmndi:BPMNPlane id="BPMNPlane_PROCESS_EMP_BATCH_REISSUE" bpmnElement="PROCESS_EMP_BATCH_REISSUE">
