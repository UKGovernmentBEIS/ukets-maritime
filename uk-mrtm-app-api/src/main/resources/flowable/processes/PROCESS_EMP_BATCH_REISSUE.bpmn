      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_subwait_catch_to_end" bpmnElement="Flow_subwait_catch_to_end">
        <omgdi:waypoint x="828" y="197" />
        <omgdi:waypoint x="890" y="197" />
